<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyVersion>1.0.151.26699</AssemblyVersion>
    <FileVersion>1.0.151.26699</FileVersion>
	<UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Icons\AIA.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Icons\AIA.ico" />
    <None Remove="Icons\AIA_s.ico" />
    <None Remove="Icons\AIA_sg.ico" />
    <None Remove="Icons\AIA_sr.ico" />
    <None Remove="Icons\AIA_t.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icons\AIA.ico" />
    <EmbeddedResource Include="Icons\AIA_s.ico" />
    <EmbeddedResource Include="Icons\AIA_sg.ico" />
    <EmbeddedResource Include="Icons\AIA_sr.ico" />
    <Resource Include="Icons\AIA_t.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NHotkey.Wpf" Version="3.0.0" />
    <PackageReference Include="PdfPig" Version="0.1.10" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="WPF-UI" Version="4.0.3" />
  </ItemGroup>

  <!-- Reference the SDK project for plugin host functionality -->
  <ItemGroup>
    <ProjectReference Include="Plugins\SDK\AIA.Plugins.SDK.csproj" />
    <ProjectReference Include="Shared\AIA.Sync.Contracts\AIA.Sync.Contracts.csproj" />
    <ProjectReference Include="Shared\AIA.Sync.Core\AIA.Sync.Core.csproj" />
  </ItemGroup>

  <!-- Embedded mobile sync API. Adds the ASP.NET Core shared framework requirement. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

