<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIA.Mobile"
             xmlns:converters="clr-namespace:AIA.Mobile.Converters"
             x:Class="AIA.Mobile.App"
             UserAppTheme="Unspecified">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <converters:PriorityToColorConverter x:Key="PriorityToColorConverter" />
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />

            <!-- Shadow for FAB -->
            <Shadow x:Key="DefaultShadow"
                    Brush="Black"
                    Offset="0,4"
                    Radius="8"
                    Opacity="0.3" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
