<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AIA.Mobile.ViewModels"
             xmlns:model="clr-namespace:AIA.Domain.Models;assembly=AIA.Domain"
             x:Class="AIA.Mobile.Pages.TasksPage"
             x:DataType="vm:TasksViewModel"
             Title="Tasks">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Task Priority Colors -->
            <Color x:Key="LowPriority">#808080</Color>
            <Color x:Key="MediumPriority">#0078D4</Color>
            <Color x:Key="HighPriority">#FFA500</Color>
            <Color x:Key="CriticalPriority">#FF4444</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Search and Filter Bar -->
        <Grid Grid.Row="0" Padding="16,8" ColumnDefinitions="*,Auto">
            <SearchBar Grid.Column="0"
                       Placeholder="Search tasks..."
                       Text="{Binding SearchText}"
                       SearchCommand="{Binding SearchCommand}" />
            
            <ImageButton Grid.Column="1"
                         Padding="8"
                         WidthRequest="48"
                         HeightRequest="48"
                         Command="{Binding ShowFilterCommand}">
                <ImageButton.Source>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xE152;" Size="24" />
                </ImageButton.Source>
            </ImageButton>
        </Grid>

        <!-- Tasks List -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Tasks}"
                            SelectionMode="None"
                            EmptyView="No tasks yet. Tap + to create one.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:TaskItem">
                        <SwipeView>
                            <!-- Swipe Actions -->
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem Text="Delete"
                                               BackgroundColor="#FF4444"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TasksViewModel}}, Path=DeleteTaskCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <!-- Task Card -->
                            <Frame Padding="12"
                                   Margin="12,6"
                                   CornerRadius="8"
                                   HasShadow="False"
                                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TasksViewModel}}, Path=EditTaskCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <!-- Priority Indicator -->
                                    <BoxView Grid.Column="0" Grid.RowSpan="3"
                                             WidthRequest="4"
                                             CornerRadius="2"
                                             Margin="0,0,12,0"
                                             Color="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}" />

                                    <!-- Title -->
                                    <Label Grid.Column="1" Grid.Row="0"
                                           Text="{Binding Title}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />

                                    <!-- Status Badge -->
                                    <Frame Grid.Column="2" Grid.Row="0"
                                           Padding="8,4"
                                           CornerRadius="12"
                                           HasShadow="False"
                                           BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                        <Label Text="{Binding Status}"
                                               FontSize="12"
                                               TextColor="#FFFFFF" />
                                    </Frame>

                                    <!-- Description -->
                                    <Label Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding Description}"
                                           FontSize="14"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           Margin="0,4,0,0"
                                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                           IsVisible="{Binding Description, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

                                    <!-- Due Date and Tags -->
                                    <HorizontalStackLayout Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2"
                                                           Margin="0,8,0,0"
                                                           Spacing="8">
                                        <!-- Due Date -->
                                        <Frame Padding="6,3"
                                               CornerRadius="8"
                                               HasShadow="False"
                                               BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2D2D2D}"
                                               IsVisible="{Binding DueDate, Converter={StaticResource IsNotNullConverter}}">
                                            <HorizontalStackLayout Spacing="4">
                                                <Label FontFamily="MaterialIcons" Text="&#xE8DF;" FontSize="14" />
                                                <Label Text="{Binding DueDate, StringFormat='{0:MMM dd}'}" FontSize="12" />
                                            </HorizontalStackLayout>
                                        </Frame>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Floating Action Button -->
        <Button Grid.Row="1"
                Text="+"
                FontSize="32"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="16"
                Command="{Binding AddTaskCommand}"
                Shadow="{StaticResource DefaultShadow}" />
    </Grid>

</ContentPage>
