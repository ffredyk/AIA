<Window x:Class="AIA.Views.MiniTaskOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AIA"
        Title="AIA Tasks"
        Width="252"
        Height="212"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="False"
        IsTabStop="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="TaskRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="3,3,6,3"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BareButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="Transparent">
        <!-- Collapsed drawer / relocation ball -->
        <Border x:Name="Ball"
                Width="40"
                Height="40"
                CornerRadius="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,4,4,0"
                Background="#E60078D4"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                Visibility="Collapsed"
                Cursor="Arrow"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BallScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Grid>
                <TextBlock Text="&#9776;"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,-2,0,0"/>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        MinWidth="15"
                        Height="15"
                        CornerRadius="7.5"
                        Background="#EE0B0B0E"
                        BorderBrush="#55FFFFFF"
                        BorderThickness="1"
                        Margin="0,0,-2,-2">
                    <TextBlock x:Name="BallCountText"
                               Text="0"
                               Foreground="White"
                               FontSize="9"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="3,0"/>
                </Border>
            </Grid>
        </Border>

        <!-- Compact task card -->
        <Border x:Name="Card"
                Width="236"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#E60E0E12"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="0,0,0,6"
                RenderTransformOrigin="1,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <StackPanel>
                <Grid Margin="12,8,12,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{local:Localize MiniTaskOverlay_Tasks}"
                                   Foreground="#D8D8DE"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Border Background="#2AFFFFFF"
                                CornerRadius="7"
                                MinWidth="17"
                                Height="14"
                                Margin="7,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TaskCountText"
                                       Text="0"
                                       Foreground="#C8C8CE"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="4,0"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="ModeHint"
                               Foreground="#7A7A84"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <ItemsControl x:Name="TaskList" Margin="7,0,7,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TaskRowStyle}"
                                    Tag="{Binding}"
                                    ToolTip="{Binding Tooltip}"
                                    MouseLeftButtonUp="TaskRow_MouseLeftButtonUp">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="3"
                                            Height="16"
                                            CornerRadius="1.5"
                                            Background="{Binding PriorityBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0"/>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource BareButtonStyle}"
                                            Tag="{Binding}"
                                            ToolTip="{local:Localize MiniTaskOverlay_ToggleComplete}"
                                            Click="TaskStatus_Click"
                                            Margin="0,0,6,0">
                                        <TextBlock Text="{Binding StatusGlyph}"
                                                   Foreground="{Binding StatusBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Button>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Title}"
                                               Foreground="#EEEEF2"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <Border Grid.Column="3"
                                            Background="#1EFFFFFF"
                                            CornerRadius="4"
                                            Padding="5,1"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CountdownText}"
                                                   Foreground="{Binding CountdownBrush}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="MoreText"
                           Foreground="#7A7A84"
                           FontSize="9"
                           Margin="12,2,12,0"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="EmptyText"
                           Text="{local:Localize MiniTaskOverlay_NoActiveTasks}"
                           Foreground="#7A7A84"
                           FontSize="11"
                           Margin="12,4,12,4"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
