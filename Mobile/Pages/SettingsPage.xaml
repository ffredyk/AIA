<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AIA.Mobile.Pages.SettingsPage"
             Title="Settings">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="Desktop sync" FontSize="18" FontAttributes="Bold" />
            <Label Text="Run AIA on the desktop, enable Mobile sync in Settings → Mobile, then pair this phone."
                   FontSize="11" TextColor="{StaticResource MutedText}" />

            <Label Text="Server URL" FontSize="11" TextColor="{StaticResource MutedText}" Margin="0,8,0,0" />
            <Entry x:Name="TxtServerUrl" Placeholder="https://your-tunnel.example.com" />

            <Label Text="Pairing code" FontSize="11" TextColor="{StaticResource MutedText}" Margin="0,8,0,0" />
            <Entry x:Name="TxtPairingCode" Placeholder="8-digit code from desktop" Keyboard="Numeric" />

            <Label Text="Device name" FontSize="11" TextColor="{StaticResource MutedText}" Margin="0,8,0,0" />
            <Entry x:Name="TxtDeviceName" Placeholder="My phone" />

            <Button Text="Pair with desktop" Clicked="BtnPair" />
            <Button Text="Save and test connection" Clicked="BtnSave" />

            <Label Text="Manual token (only if you copied it)" FontSize="11" TextColor="{StaticResource MutedText}" Margin="0,8,0,0" />
            <Entry x:Name="TxtToken" Placeholder="Optional bearer token" IsPassword="True" />
            <Label x:Name="LblTokenStatus" FontSize="11" TextColor="{StaticResource MutedText}" />

            <Button Text="Sync now" Clicked="BtnSync" Margin="0,8,0,0" />
            <Label x:Name="StatusLabel" FontSize="11" TextColor="{StaticResource MutedText}" />

            <BoxView HeightRequest="1" BackgroundColor="#3E3E42" Margin="0,12" />

            <Label Text="Device features" FontSize="18" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout>
                    <Label Text="Mirror tasks to phone calendar" FontSize="14" />
                    <Label Text="AIA events and due reminders appear in a local AIA calendar."
                           FontSize="11" TextColor="{StaticResource MutedText}" />
                </VerticalStackLayout>
                <Switch x:Name="SwCalendar" Grid.Column="1" Toggled="SwCalendar_Toggled" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout>
                    <Label Text="Notifications" FontSize="14" />
                    <Label Text="Remind me when tasks, reminders, or events are due."
                           FontSize="11" TextColor="{StaticResource MutedText}" />
                </VerticalStackLayout>
                <Switch x:Name="SwNotifications" Grid.Column="1" Toggled="SwNotifications_Toggled" />
            </Grid>

            <BoxView HeightRequest="1" BackgroundColor="#3E3E42" Margin="0,12" />

            <Label Text="Security" FontSize="14" FontAttributes="Bold" />
            <Label Text="Use an HTTPS URL. The app stores the device token in Android SecureStorage. Revoke the device in desktop Settings → Mobile if the phone is lost."
                   FontSize="11" TextColor="#FFA500" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
