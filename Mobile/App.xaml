<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AIA.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBackground">#1E1E1E</Color>
            <Color x:Key="PanelBackground">#2D2D30</Color>
            <Color x:Key="AccentColor">#0078D4</Color>
            <Color x:Key="MutedText">#999999</Color>

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="White" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource AccentColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{StaticResource PanelBackground}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="PlaceholderColor" Value="{StaticResource MutedText}" />
            </Style>
            <Style TargetType="Switch">
                <Setter Property="OnColor" Value="{StaticResource AccentColor}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
